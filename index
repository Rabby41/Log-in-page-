function showAlert(containerId, type, msg) {
  const el = document.getElementById(containerId);
  if (!el) return;
  el.innerHTML = `
    <div class="alert alert-${type}">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px">
        ${type === 'success'
          ? '<polyline points="20 6 9 17 4 12"/>'
          : '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>'}
      </svg>
      ${msg}
    </div>`;
}

function shakeCard() {
  const card = document.getElementById('mainCard');
  card.classList.remove('shake');
  void card.offsetWidth;
  card.classList.add('shake');
}

function checkStrength(pw, fillId, textId, rulePrefix) {
  const rules = {
    length:  pw.length >= 8,
    upper:   /[A-Z]/.test(pw),
    lower:   /[a-z]/.test(pw),
    number:  /[0-9]/.test(pw),
    special: /[^A-Za-z0-9]/.test(pw),
  };
  let score = Object.values(rules).filter(Boolean).length;

  const fill = document.getElementById(fillId);
  const text = document.getElementById(textId);

  if (!fill || !text) return rules;

  const configs = [
    { pct: '20%', color: '#ff4d6a', label: 'Very weak' },
    { pct: '40%', color: '#ff7c47', label: 'Weak' },
    { pct: '60%', color: '#ffb347', label: 'Fair' },
    { pct: '80%', color: '#4a9eff', label: 'Strong' },
    { pct: '100%', color: '#00e5b0', label: 'Excellent' },
  ];

  const cfg = configs[Math.max(0, score - 1)];
  fill.style.width = pw.length ? cfg.pct : '0%';
  fill.style.background = cfg.color;
  text.textContent = pw.length ? cfg.label : '';
  text.style.color = cfg.color;

  Object.entries(rules).forEach(([k, v]) => {
    const el = document.getElementById(`${rulePrefix}-${k}`);
    if (el) el.classList.toggle('ok', v);
  });

  return rules;
}

// ══════════════════════════════════════════════
// EVENT BINDING
// ══════════════════════════════════════════════
let resendInterval = null;

function bindEvents() {
  // ── LOGIN ──
  if (state.view === 'login') {
    const loginBtn = document.getElementById('loginBtn');
    const togglePw = document.getElementById('togglePw');
    const pwInput  = document.getElementById('password');
    const forgotLink = document.getElementById('forgotLink');

    pwInput?.addEventListener('input', () => {
      const bar = document.getElementById('strengthBar');
      if (bar) bar.classList.add('show');
      checkStrength(pwInput.value, 'strengthFill', 'strengthText', 'r');
    });

    togglePw?.addEventListener('click', () => {
      const isText = pwInput.type === 'text';
      pwInput.type = isText ? 'password' : 'text';
      togglePw.innerHTML = isText
        ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
           </svg>`
        : `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
            <line x1="1" y1="1" x2="23" y2="23"/>
           </svg>`;
    });

    forgotLink?.addEventListener('click', () => {
      state.username = document.getElementById('username')?.value || '';
      state.view = 'recovery';
      render();
    });

    loginBtn?.addEventListener('click', handleLogin);

    // Enter key
    document.getElementById('password')?.addEventListener('keydown', e => {
      if (e.key === 'Enter') handleLogin();
    });
    document.getElementById('username')?.addEventListener('keydown', e => {
      if (e.key === 'Enter') document.getElementById('password')?.focus();
    });
  }

  // ── OTP ──
  if (state.view === 'otp') {
    document.getElementById('backBtn')?.addEventListener('click', () => {
      state.view = 'login';
      render();
    });

    const cells = document.querySelectorAll('.otp-cell');
    cells.forEach((cell, i) => {
      cell.addEventListener('input', () => {
        cell.value = cell.value.replace(/[^0-9]/g, '').slice(0, 1);
        if (cell.value && i < 5) cells[i + 1].focus();
      });
      cell.addEventListener('keydown', e => {
        if (e.key === 'Backspace' && !cell.value && i > 0) cells[i - 1].focus();
        if (e.key === 'Enter') verifyOTP();
      });
      cell.addEventListener('paste', e => {
        const pasted = e.clipboardData.getData('text').replace(/\D/g,'').slice(0,6);
        cells.forEach((c, idx) => { c.value = pasted[idx] || ''; });
        cells[Math.min(5, pasted.length - 1)]?.focus();
        e.preventDefault();
      });
    });

    document.getElementById('verifyOtpBtn')?.addEventListener('click', verifyOTP);

    // Resend countdown
    let resendSec = 30;
    clearInterval(resendInterval);
    resendInterval = setInterval(() => {
      const el = document.getElementById('resendTimer');
      if (!el) { clearInterval(resendInterval); return; }
      resendSec--;
      el.textContent = resendSec;
      if (resendSec <= 0) {
        clearInterval(resendInterval);
        const link = document.getElementById('resendOtp');
        if (link) {
          link.innerHTML = 'Resend code';
          link.style.color = 'var(--accent)';
          link.style.cursor = 'pointer';
          link.addEventListener('click', () => {
            showAlert('otpAlert', 'success', 'A new code has been sent to your email & phone.');
          });
        }
      }
    }, 1000);

    setTimeout(() => cells[0]?.focus(), 100);
  }

  // ── RECOVERY ──
  if (state.view === 'recovery') {
    document.getElementById('backToLogin')?.addEventListener('click', () => {
      state.view = 'login'; render();
    });
    document.querySelectorAll('[data-method]').forEach(btn => {
      btn.addEventListener('click', () => {
        state.recoveryMethod = btn.dataset.method;
        render();
      });
    });
    document.getElementById('sendRecoveryBtn')?.addEventListener('click', () => {
      const u = document.getElementById('recoveryUser')?.value?.trim();
      if (!u) { showAlert('recoveryAlert', 'danger', 'Please enter your username.'); return; }
      if (!state.users[u]) { showAlert('recoveryAlert', 'danger', 'Username not found.'); return; }
      state.username = u;
      const dest = state.recoveryMethod === 'email'
        ? state.users[u].email
        : state.users[u].phone;
      showAlert('recoveryAlert', 'success', `Code sent to ${dest}. Check your ${state.recoveryMethod}.`);
      setTimeout(() => { state.view = 'recovery-verify'; render(); }, 1500);
    });
  }

  // ── RECOVERY VERIFY ──
  if (state.view === 'recovery-verify') {
    document.getElementById('cancelRecovery')?.addEventListener('click', () => {
      state.view = 'login'; render();
    });

    document.getElementById('newPw')?.addEventListener('input', e => {
      checkStrength(e.target.value, 'newStrengthFill', 'newStrengthText', 'nr');
    });

    document.getElementById('resetPwBtn')?.addEventListener('click', () => {
      const code = document.getElementById('recoveryCode')?.value?.trim();
      const np   = document.getElementById('newPw')?.value;
      const cp   = document.getElementById('confirmPw')?.value;

      if (code !== '654321') {
        showAlert('rvAlert', 'danger', 'Invalid recovery code. Please try again.');
        return;
      }
      const rules = checkStrength(np, 'newStrengthFill', 'newStrengthText', 'nr');
      if (!rules.length) {
        showAlert('rvAlert', 'danger', 'Password must be at least 8 characters.'); return;
      }
      if (!rules.upper || !rules.lower || !rules.number) {
        showAlert('rvAlert', 'danger', 'Password does not meet strength requirements.'); return;
      }
      if (np !== cp) {
        showAlert('rvAlert', 'danger', 'Passwords do not match.'); return;
      }

      // Update hash
      state.users[state.username].passwordHash = hashPassword(np);
      state.failedAttempts = 0;

      showAlert('rvAlert', 'success', 'Password reset successful! Redirecting to login...');
      setTimeout(() => { state.view = 'login'; render(); }, 1800);
    });
  }

  // ── SUCCESS ──
  if (state.view === 'success') {
    document.getElementById('logoutBtn')?.addEventListener('click', () => {
      state.failedAttempts = 0;
      state.username = '';
      state.view = 'login';
      render();
    });
  }

  // ── LOCKED ──
  if (state.view === 'locked') {
    startLockoutTimer();
  }
}

// ══════════════════════════════════════════════
// HANDLERS
// ══════════════════════════════════════════════
function handleLogin() {
  const username = document.getElementById('username')?.value?.trim();
  const password = document.getElementById('password')?.value;

  if (!username || !password) {
    showAlert('alertBox', 'danger', 'Please enter both username and password.');
    shakeCard();
    return;
  }

  const user = state.users[username];
  if (!user || !verifyPassword(password, user.passwordHash)) {
    state.failedAttempts++;

    if (state.failedAttempts >= state.maxAttempts) {
      state.lockoutEnd = Date.now() + state.lockoutDuration * 1000;
      state.view = 'locked';
      render();
      return;
    }

    const remaining = state.maxAttempts - state.failedAttempts;
    showAlert('alertBox', 'danger',
      `Invalid credentials. <strong>${remaining} attempt${remaining !== 1 ? 's' : ''} remaining</strong> before lockout.`);
    shakeCard();
    // Highlight fields
    document.getElementById('username')?.classList.add('error');
    document.getElementById('password')?.classList.add('error');
    setTimeout(() => {
      document.getElementById('username')?.classList.remove('error');
      document.getElementById('password')?.classList.remove('error');
    }, 2000);
    return;
  }

  // Credentials valid — proceed to 2FA
  state.username = username;
  const dev = getDeviceInfo();
  state.lastDevice = dev;

  if (user.mfa) {
    state.view = 'otp';
    render();
  } else {
    grantAccess(dev);
  }
}

function verifyOTP() {
  const cells = document.querySelectorAll('.otp-cell');
  const code = Array.from(cells).map(c => c.value).join('');

  if (code.length < 6) {
    showAlert('otpAlert', 'danger', 'Please enter all 6 digits.');
    return;
  }

  if (code !== '123456') {
    showAlert('otpAlert', 'danger', 'Incorrect code. Please try again.');
    cells.forEach(c => c.classList.add('error'));
    setTimeout(() => cells.forEach(c => { c.classList.remove('error'); c.value = ''; }), 1200);
    cells[0].focus();
    return;
  }

  const dev = state.lastDevice;
  grantAccess(dev);
}

function grantAccess(dev) {
  clearInterval(resendInterval);
  state.lastDevice = dev || getDeviceInfo();
  state.failedAttempts = 0;
  state.view = 'success';
  render();

  // Mark device as known
  if (!state.knownDevices.includes(dev?.fp)) {
    state.knownDevices.push(dev?.fp);
    // In production: send email/SMS notification about new device login
    console.log('[SECURITY] New device login detected — notification sent to', state.users[state.username].email);
  }
}

function startLockoutTimer() {
  const countEl = document.getElementById('lockdownCount');
  clearInterval(state.lockoutTimer);
  state.lockoutTimer = setInterval(() => {
    const rem = Math.max(0, Math.ceil((state.lockoutEnd - Date.now()) / 1000));
    const m = String(Math.floor(rem / 60)).padStart(2, '0');
    const s = String(rem % 60).padStart(2, '0');
    if (countEl) countEl.textContent = `${m}:${s}`;
    if (rem <= 0) {
      clearInterval(state.lockoutTimer);
      state.failedAttempts = 0;
      state.view = 'login';
      render();
    }
  }, 500);
}

// ══════════════════════════════════════════════
// INIT
// ══════════════════════════════════════════════
render();
</script>
