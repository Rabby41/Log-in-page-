<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SecureVault — Login</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #070b12;
    --surface: #0d1420;
    --surface2: #121a28;
    --border: rgba(99,179,237,0.12);
    --border-active: rgba(99,179,237,0.45);
    --accent: #4a9eff;
    --accent-glow: rgba(74,158,255,0.18);
    --accent2: #00e5b0;
    --text: #e8edf5;
    --text-muted: #7a8fa8;
    --text-dim: #4a5a70;
    --success: #00e5b0;
    --danger: #ff4d6a;
    --warning: #ffb347;
    --font: 'Space Grotesk', sans-serif;
    --mono: 'JetBrains Mono', monospace;
    --radius: 12px;
    --radius-sm: 8px;
  }

  body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  /* Animated background grid */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(74,158,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(74,158,255,0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    animation: gridPan 20s linear infinite;
    pointer-events: none;
  }

  body::after {
    content: '';
    position: fixed;
    top: -30%;
    left: -10%;
    width: 60%;
    height: 70%;
    background: radial-gradient(ellipse, rgba(74,158,255,0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  @keyframes gridPan {
    0% { transform: translateY(0); }
    100% { transform: translateY(48px); }
  }

  /* ─── WRAPPER ─── */
  .wrapper {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 460px;
    padding: 20px;
  }

  /* ─── BRAND ─── */
  .brand {
    text-align: center;
    margin-bottom: 32px;
    animation: fadeDown 0.6s ease both;
  }

  .brand-icon {
    width: 52px; height: 52px;
    margin: 0 auto 12px;
    background: linear-gradient(135deg, rgba(74,158,255,0.2), rgba(0,229,176,0.1));
    border: 1px solid var(--border-active);
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .brand-icon::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(74,158,255,0.1), transparent);
    animation: shimmer 3s ease infinite;
  }

  @keyframes shimmer {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .brand-icon svg { position: relative; z-index: 1; }

  .brand h1 {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.5px;
    background: linear-gradient(135deg, #e8edf5 40%, #4a9eff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .brand p {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 4px;
    letter-spacing: 0.2px;
  }

  /* ─── CARD ─── */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 36px 32px;
    position: relative;
    overflow: hidden;
    animation: fadeUp 0.6s ease both 0.1s;
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(74,158,255,0.4), transparent);
  }

  /* ─── SECURITY BADGE ─── */
  .security-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(0,229,176,0.06);
    border: 1px solid rgba(0,229,176,0.15);
    border-radius: 100px;
    padding: 5px 12px 5px 8px;
    font-size: 12px;
    color: var(--accent2);
    font-family: var(--mono);
    letter-spacing: 0.3px;
    width: fit-content;
    margin-bottom: 24px;
  }

  .security-badge .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent2);
    box-shadow: 0 0 6px var(--accent2);
    animation: pulse 2s ease infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.8); }
  }

  /* ─── SECTION TITLES ─── */
  .section-title {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.3px;
    margin-bottom: 6px;
  }

  .section-sub {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 24px;
    line-height: 1.5;
  }

  /* ─── FORM ELEMENTS ─── */
  .field {
    margin-bottom: 16px;
  }

  label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .input-wrap {
    position: relative;
  }

  .input-wrap .icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-dim);
    display: flex;
    pointer-events: none;
    transition: color 0.2s;
  }

  input[type="text"],
  input[type="password"],
  input[type="email"] {
    width: 100%;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: var(--font);
    font-size: 14px;
    padding: 12px 14px 12px 42px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }

  input[type="text"]:focus,
  input[type="password"]:focus,
  input[type="email"]:focus {
    border-color: var(--border-active);
    box-shadow: 0 0 0 3px rgba(74,158,255,0.1);
    background: rgba(74,158,255,0.03);
  }

  input[type="text"]:focus ~ .icon,
  input[type="password"]:focus ~ .icon {
    color: var(--accent);
  }

  input::placeholder { color: var(--text-dim); }

  input.error { border-color: rgba(255,77,106,0.6); }
  input.success { border-color: rgba(0,229,176,0.5); }

  .toggle-pw {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-dim);
    display: flex;
    transition: color 0.2s;
    padding: 2px;
  }
  .toggle-pw:hover { color: var(--text-muted); }

  /* ─── PASSWORD STRENGTH ─── */
  .strength-bar {
    margin-top: 10px;
    display: none;
  }

  .strength-bar.show { display: block; }

  .strength-track {
    height: 3px;
    background: var(--surface2);
    border-radius: 4px;
    overflow: hidden;
  }

  .strength-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.4s ease, background 0.4s ease;
    width: 0%;
  }

  .strength-label {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 5px;
  }

  .strength-label span:last-child { font-weight: 500; }

  .strength-rules {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 12px;
    margin-top: 10px;
  }

  .rule {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: var(--text-dim);
    transition: color 0.2s;
  }

  .rule.ok { color: var(--success); }

  .rule-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  /* ─── OTP ─── */
  .otp-grid {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin: 16px 0;
  }

  .otp-cell {
    width: 48px; height: 56px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: var(--mono);
    font-size: 22px;
    font-weight: 500;
    text-align: center;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    caret-color: var(--accent);
  }

  .otp-cell:focus {
    border-color: var(--border-active);
    box-shadow: 0 0 0 3px rgba(74,158,255,0.1);
  }

  /* ─── BUTTON ─── */
  .btn {
    width: 100%;
    padding: 13px;
    border-radius: var(--radius-sm);
    border: none;
    cursor: pointer;
    font-family: var(--font);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2px;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .btn-primary {
    background: linear-gradient(135deg, #2d7deb, #1e5fc7);
    color: #fff;
    box-shadow: 0 4px 20px rgba(45,125,235,0.3);
  }

  .btn-primary:hover:not(:disabled) {
    background: linear-gradient(135deg, #3d8df7, #2d7deb);
    box-shadow: 0 6px 24px rgba(45,125,235,0.4);
    transform: translateY(-1px);
  }

  .btn-primary:active:not(:disabled) { transform: translateY(0); }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .btn-ghost:hover { background: var(--surface2); color: var(--text); }

  /* ─── ALERTS ─── */
  .alert {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 1.5;
    margin-bottom: 16px;
    animation: fadeIn 0.3s ease;
  }

  .alert-danger {
    background: rgba(255,77,106,0.08);
    border: 1px solid rgba(255,77,106,0.25);
    color: #ff6b83;
  }

  .alert-success {
    background: rgba(0,229,176,0.08);
    border: 1px solid rgba(0,229,176,0.25);
    color: var(--success);
  }

  .alert-info {
    background: rgba(74,158,255,0.08);
    border: 1px solid rgba(74,158,255,0.2);
    color: var(--accent);
  }

  .alert-warn {
    background: rgba(255,179,71,0.08);
    border: 1px solid rgba(255,179,71,0.25);
    color: var(--warning);
  }

  /* ─── LOCKOUT TIMER ─── */
  .lockout-box {
    text-align: center;
    padding: 20px;
  }

  .lockout-icon {
    font-size: 40px;
    margin-bottom: 12px;
    display: block;
  }

  .countdown {
    font-family: var(--mono);
    font-size: 36px;
    font-weight: 500;
    color: var(--danger);
    letter-spacing: 2px;
    margin: 12px 0;
  }

  /* ─── DIVIDER ─── */
  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0;
    color: var(--text-dim);
    font-size: 12px;
  }

  .divider::before, .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  /* ─── LINKS ─── */
  .link {
    color: var(--accent);
    text-decoration: none;
    font-size: 13px;
    cursor: pointer;
    transition: color 0.2s;
  }

  .link:hover { color: #7ab8ff; }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  /* ─── REMEMBER ME ─── */
  .checkbox-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 13px;
    color: var(--text-muted);
  }

  .checkbox-wrap input[type="checkbox"] {
    width: 16px; height: 16px;
    accent-color: var(--accent);
    cursor: pointer;
    border-radius: 4px;
    padding: 0;
    border: 1px solid var(--border);
  }

  /* ─── ATTEMPT DOTS ─── */
  .attempt-dots {
    display: flex;
    gap: 6px;
    justify-content: center;
    margin: 12px 0;
  }

  .attempt-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--border);
    transition: background 0.3s, box-shadow 0.3s;
  }

  .attempt-dot.used {
    background: var(--danger);
    box-shadow: 0 0 6px rgba(255,77,106,0.5);
  }

  /* ─── DEVICE INFO ─── */
  .device-card {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px;
    margin: 14px 0;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }

  .device-icon {
    width: 38px; height: 38px;
    background: rgba(74,158,255,0.1);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .device-label { color: var(--text-muted); font-size: 11px; }
  .device-value { color: var(--text); font-weight: 500; }

  /* ─── SUCCESS STATE ─── */
  .success-screen {
    text-align: center;
    padding: 16px 0;
  }

  .success-ring {
    width: 72px; height: 72px;
    border-radius: 50%;
    border: 2px solid var(--success);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 20px;
    background: rgba(0,229,176,0.08);
    animation: ringPop 0.5s ease both;
    box-shadow: 0 0 24px rgba(0,229,176,0.2);
  }

  @keyframes ringPop {
    0% { transform: scale(0.7); opacity: 0; }
    70% { transform: scale(1.1); }
    100% { transform: scale(1); opacity: 1; }
  }

  /* ─── ANIMATIONS ─── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeDown {
    from { opacity: 0; transform: translateY(-10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes shake {
    0%,100% { transform: translateX(0); }
    20% { transform: translateX(-8px); }
    40% { transform: translateX(8px); }
    60% { transform: translateX(-5px); }
    80% { transform: translateX(5px); }
  }

  .shake { animation: shake 0.4s ease; }

  /* ─── FOOTER ─── */
  .card-footer {
    text-align: center;
    margin-top: 20px;
    font-size: 13px;
    color: var(--text-muted);
  }

  /* ─── RECOVERY METHODS ─── */
  .method-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 16px 0;
  }

  .method-btn {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px 12px;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s;
    color: var(--text-muted);
    font-family: var(--font);
    font-size: 13px;
  }

  .method-btn:hover {
    border-color: var(--border-active);
    color: var(--text);
    background: rgba(74,158,255,0.05);
  }

  .method-btn.active {
    border-color: var(--border-active);
    background: rgba(74,158,255,0.08);
    color: var(--accent);
  }

  .method-icon { font-size: 20px; display: block; margin-bottom: 6px; }

  /* ─── STEPS INDICATOR ─── */
  .steps {
    display: flex;
    gap: 6px;
    margin-bottom: 24px;
  }

  .step-bar {
    height: 3px;
    border-radius: 4px;
    flex: 1;
    background: var(--border);
    transition: background 0.4s;
  }

  .step-bar.active { background: var(--accent); }
  .step-bar.done { background: var(--success); }

  /* ─── SCROLLBAR ─── */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
</style>
</head>
<body>

<div class="wrapper">
  <div class="brand">
    <div class="brand-icon">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </div>
    <h1>SecureVault</h1>
    <p>Enterprise-grade authentication portal</p>
  </div>

  <div class="card" id="mainCard">
    <!-- VIEWS ARE INJECTED HERE VIA JS -->
  </div>
</div>

<script>
// ══════════════════════════════════════════════
// STATE
// ══════════════════════════════════════════════
const state = {
  view: 'login',           // login | otp | recovery | recovery-verify | success | locked
  failedAttempts: 0,
  maxAttempts: 3,
  lockoutDuration: 30,     // seconds
  lockoutTimer: null,
  lockoutEnd: null,
  username: '',
  passwordVisible: false,
  otpDigits: ['','','','','',''],
  recoveryMethod: 'email',
  recoveryStep: 1,
  // Simulated user DB (in real app: server-side + bcrypt hash)
  users: {
    'admin': {
      // "password123" — in production, this would be a bcrypt hash stored server-side
      passwordHash: hashPassword('password123'),
      email: 'adm***@example.com',
      phone: '+880 1***-***789',
      mfa: true
    }
  },
  lastDevice: null,
  knownDevices: [],
};

// ══════════════════════════════════════════════
// SIMPLE HASH SIMULATION (SHA-256 via SubtleCrypto)
// In production: use bcrypt/argon2 server-side
// ══════════════════════════════════════════════
function hashPassword(pw) {
  // Deterministic fake hash for demo — real app uses bcrypt server-side
  let hash = 0;
  for (let c of pw + 'salt_securevault_2025') {
    hash = ((hash << 5) - hash) + c.charCodeAt(0);
    hash |= 0;
  }
  return hash.toString(16);
}

function verifyPassword(input, stored) {
  return hashPassword(input) === stored;
}

// ══════════════════════════════════════════════
// DEVICE FINGERPRINT (simplified)
// ══════════════════════════════════════════════
function getDeviceInfo() {
  const ua = navigator.userAgent;
  let device = 'Unknown Device';
  let os = 'Unknown OS';
  if (/mobile/i.test(ua)) device = 'Mobile Browser';
  else if (/tablet/i.test(ua)) device = 'Tablet Browser';
  else device = 'Desktop Browser';
  if (/Windows/i.test(ua)) os = 'Windows';
  else if (/Mac/i.test(ua)) os = 'macOS';
  else if (/Linux/i.test(ua)) os = 'Linux';
  else if (/Android/i.test(ua)) os = 'Android';
  else if (/iOS|iPhone|iPad/i.test(ua)) os = 'iOS';
  const fp = btoa(navigator.userAgent + screen.width + screen.height).slice(0, 16);
  return { device, os, fp, browser: ua.split(' ').pop().split('/')[0] };
}

// ══════════════════════════════════════════════
// RENDER ENGINE
// ══════════════════════════════════════════════
function render() {
  const card = document.getElementById('mainCard');
  switch(state.view) {
    case 'login':     card.innerHTML = renderLogin(); break;
    case 'otp':       card.innerHTML = renderOTP(); break;
    case 'recovery':  card.innerHTML = renderRecovery(); break;
    case 'recovery-verify': card.innerHTML = renderRecoveryVerify(); break;
    case 'success':   card.innerHTML = renderSuccess(); break;
    case 'locked':    card.innerHTML = renderLocked(); break;
  }
  bindEvents();
}

// ══════════════════════════════════════════════
// VIEW: LOGIN
// ══════════════════════════════════════════════
function renderLogin() {
  const dots = [0,1,2].map(i =>
    `<div class="attempt-dot ${i < state.failedAttempts ? 'used' : ''}"></div>`
  ).join('');

  return `
    <div class="security-badge">
      <span class="dot"></span>
      256-bit TLS · CSRF Protected
    </div>

    <p class="section-title">Welcome back</p>
    <p class="section-sub">Sign in to your secure account</p>

    <div id="alertBox"></div>

    <div class="field">
      <label>Username</label>
      <div class="input-wrap">
        <input type="text" id="username" placeholder="Enter username" autocomplete="username"
          value="${state.username}" spellcheck="false">
        <span class="icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </span>
      </div>
    </div>

    <div class="field">
      <label>Password</label>
      <div class="input-wrap">
        <input type="password" id="password" placeholder="Enter password" autocomplete="current-password">
        <span class="icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </span>
        <button class="toggle-pw" id="togglePw" type="button" title="Show/hide password">
          <svg id="eyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
